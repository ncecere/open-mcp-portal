{
  "name": "open-mcp-portal-web",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "gen": "node --test scripts/prepare-openapi.node-check.mjs && node scripts/prepare-openapi.mjs && openapi-typescript ../api/openapi.yaml -o src/api/schema.gen.ts",
    "test": "node --test scripts/prepare-openapi.node-check.mjs && vitest run",
    "check:styling": "node scripts/check-styling.mjs",
    "check:size": "node scripts/check-size.mjs",
    "ui:check": "bitop diff --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "lucide-react": "1.63.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "openapi-typescript": {
      "@redocly/openapi-core": {
        ".": "1.34.22",
        "minimatch": "11.0.1"
      }
    }
  },
  "devDependencies": {
    "@bitop-dev/cli": "0.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-axe": "0.1.0"
  }
}
